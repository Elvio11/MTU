# =============================================================================
# MTUS — MemeTrader Unified System
# Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the required values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: RPC Providers
# -----------------------------------------------------------------------------
# At least one RPC provider must be configured. Helius is recommended as primary.

HELIUS_KEY=your_helius_api_key
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_KEY}
HELIUS_WSS=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_KEY}

QUICKNODE_URL=https://your-quicknode-url
ALCHEMY_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/your_key

# -----------------------------------------------------------------------------
# REQUIRED: Redis
# -----------------------------------------------------------------------------
# Redis is the message bus for all inter-agent communication.

REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# REQUIRED: PostgreSQL
# -----------------------------------------------------------------------------
# PostgreSQL stores positions and the audit ledger.
# If not set, falls back to individual DB_USER/DB_PASSWORD/DB_HOST vars.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mtus_db

# Alternative (used if DATABASE_URL is not set):
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mtus_db

# -----------------------------------------------------------------------------
# REQUIRED: Environment Mode
# -----------------------------------------------------------------------------
# "paper" = simulated trades (no on-chain transactions)
# "production" = real trades with real SOL

MTUS_ENVIRONMENT=paper

# -----------------------------------------------------------------------------
# REQUIRED: Wallet Keystores
# -----------------------------------------------------------------------------
# Keystores are encrypted wallet files. Generate with:
#   python scripts/generate_keystores.py
#   or
#   npx ts-node scripts/generate_keystores.ts

SNIPER_KEYSTORE_PATH=./keystores/sniper.keystore
MAIN_KEYSTORE_PATH=./keystores/main.keystore
SNIPER_PASSPHRASE=your_keystore_passphrase

# -----------------------------------------------------------------------------
# OPTIONAL: Price APIs
# -----------------------------------------------------------------------------
# Used by Oracle agent for price polling. Jupiter V3 is free.
# Birdeye and RugCheck require API keys for full access.

BIRDEYE_API_KEY=your_birdeye_api_key
RUGCHECK_API_KEY=your_rugcheck_api_key

# -----------------------------------------------------------------------------
# OPTIONAL: Telegram Bot
# -----------------------------------------------------------------------------
# Required for admin remote control. Create a bot via @BotFather on Telegram.

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id
TELEGRAM_OTP_SEED=your_pre_shared_otp_seed

# -----------------------------------------------------------------------------
# OPTIONAL: Honeypot Detection
# -----------------------------------------------------------------------------

HONEYPOT_CHECK_ENABLED=true
HONEYPOT_SIMULATION_AMOUNT=0.0001

# -----------------------------------------------------------------------------
# OPTIONAL: Dashboard
# -----------------------------------------------------------------------------

DASHBOARD_PORT=3000
DASHBOARD_WS_PORT=3001
DASHBOARD_ENABLED=true

# -----------------------------------------------------------------------------
# OPTIONAL: Configuration Path
# -----------------------------------------------------------------------------

CONFIG_PATH=./config/config.yaml
